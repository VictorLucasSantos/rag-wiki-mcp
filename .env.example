# Copie para .env e ajuste.

# ── LLM: "ollama" (local, grátis) ou "anthropic" (Claude, pago) ──
LLM_BACKEND=ollama

# Ollama (precisa estar rodando: `ollama serve`; baixe modelos com `ollama pull <nome>`)
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_AUX_MODEL=qwen3.5:4b     # multi-query, HyDE, contextual retrieval
# OLLAMA_JUDGE_MODEL=qwen3.5:4b   # juiz do evaluate.py --generate (use o maior que tiver)
OLLAMA_NUM_CTX=8192               # janela de contexto; o Ollama CORTA o que passar disso
OLLAMA_TEMPERATURE=0.2
OLLAMA_THINK=false                # true = raciocina antes de responder (melhor, mais lento)
# OLLAMA_HOST=http://localhost:11434

# Anthropic (só se LLM_BACKEND=anthropic). Chave em https://platform.claude.com
# Alternativa à chave: `ant auth login` (o SDK lê o perfil automaticamente).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_AUX_MODEL=claude-haiku-4-5
LLM_JUDGE_MODEL=claude-sonnet-5-5

# ── Embeddings: local (sentence-transformers) ou openai ──
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# OPENAI_API_KEY=   # só se EMBEDDING_BACKEND=openai

# ── Vector store: chroma (local) ou qdrant ──
VECTOR_BACKEND=chroma
# QDRANT_URL=http://localhost:6333

# ── Chunking: auto | recursive | markdown | parent_child ──
CHUNK_STRATEGY=auto
CONTEXTUAL_RETRIEVAL=false

# Re-ranking com cross-encoder (baixa ~2 GB na primeira vez)
USE_RERANKER=false
